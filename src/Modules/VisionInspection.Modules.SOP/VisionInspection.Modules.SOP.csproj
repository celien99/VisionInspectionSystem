<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <!--
      YoloDotNet 走 NuGet（原先是仓库外的 ProjectReference，别人 clone 下来根本编译不了）。
      EP 包与 Microsoft.ML.OnnxRuntime 由 Modules.Detection 传递引入，这里不要再单独引用，
      否则 CPU/GPU 两套 onnxruntime 原生 DLL 会互相覆盖。
    -->
    <PackageReference Include="YoloDotNet" Version="4.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\VisionInspection.Core\VisionInspection.Core.csproj" />
    <ProjectReference Include="..\VisionInspection.Modules.Detection\VisionInspection.Modules.Detection.csproj" />
  </ItemGroup>

</Project>
